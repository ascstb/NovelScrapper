# AWS SDK default credential provider chain also supports shared profiles and IAM roles.
# Set these variables in your environment when using access keys.
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
# Include AWS_SESSION_TOKEN when using temporary credentials.
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
# This application does not automatically load .env files.
